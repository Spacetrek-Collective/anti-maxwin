# Disalin ke .env DI VPS (jangan isi key di laptop kalau tidak perlu).
# Nama anggota tim yang menjalankan CLI (untuk log approve/submit). Di UI diisi lewat form.
MEMBER=

# --- LLM (OpenAI-compatible, akses DeepSeek dari panitia) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_CHARS=3000
TRIAGE_CONCURRENCY=4
# Confidence minimal untuk status "verified" (di bawahnya "review")
MIN_CONFIDENCE=0.8
# true = verified dengan confidence >= AUTO_QUEUE_CONFIDENCE langsung masuk antrean submit tanpa approve
AUTO_QUEUE=false
AUTO_QUEUE_CONFIDENCE=0.95

# --- Search (SearXNG self-hosted di compose, tanpa API key) ---
# Wajib diisi: openssl rand -hex 32
SEARXNG_SECRET=
# Default service searxng di compose. Ganti kalau SearXNG jalan di mesin lain (mis. VM teman via Tailscale).
SEARXNG_URL=http://searxng:8080
# Kosong = semua engine aktif di settings.yml. Contoh: google,bing,duckduckgo,brave,mojeek
SEARXNG_ENGINES=
SEARXNG_LANGUAGE=id-ID
SEARCH_PAGES=2
# Jeda antar request ke SearXNG (ms). Makin pelan, makin jarang engine kena captcha.
SEARCH_DELAY_MS=8000
DISCOVER_INTERVAL_MIN=360
CRTSH_DAYS=30

# --- Browser ---
CONCURRENCY=4
NAV_TIMEOUT_MS=25000
SETTLE_MS=2500
# 1 = Chromium dengan sandbox (butuh docker/seccomp_profile.json). 0 = tanpa sandbox.
CHROMIUM_SANDBOX=1
CLOAK_CHECK=true
# Proxy keluar untuk browser, mis. proxy Indonesia: http://host:port / socks5://host:port
PROXY=

# --- Crawler iklan ---
AD_RELOADS=6
AD_MAX_LINKS_PER_SEED=25
AD_RECRAWL_HOURS=6

# --- Review UI ---
UI_PORT=8787
# Basic auth (username bebas). Kosong = tanpa auth (tetap hanya bisa diakses via SSH tunnel).
UI_PASSWORD=
