# Endpoint OpenAI-compatible. Ganti sesuai akses DeepSeek dari panitia.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Batas confidence minimal agar otomatis "verified" (di bawahnya masuk "review")
MIN_CONFIDENCE=0.8
# Jumlah tab browser paralel saat verifikasi
CONCURRENCY=4
